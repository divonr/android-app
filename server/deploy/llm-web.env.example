# LLM API Web Server — Environment Variables
# Copy this file to llm-web.env and fill in real values.
# The real llm-web.env is gitignored.

# ── Required ──────────────────────────────────────────────────────────────────

# Password for the web UI login page
WEB_UI_PASSWORD=change-me-before-deploying

# Secret used to sign session cookies (any long random string, e.g. openssl rand -hex 32)
WEB_UI_SESSION_SECRET=change-me-before-deploying

# Path to the built React app (web/dist)
WEB_STATIC_DIR=/home/divonr/ApI/android-app/web/dist

# Public URL (used to build OAuth redirect URIs)
PUBLIC_BASE_URL=https://app.api-divonr.xyz

# ── Optional: OAuth ───────────────────────────────────────────────────────────

# GitHub OAuth App credentials
# Create at: https://github.com/settings/developers → OAuth Apps
# Callback URL: https://app.api-divonr.xyz/oauth/github/callback
# (Leave unset to use the built-in desktop app fallback)
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=

# Google OAuth Web Client credentials
# Create at: https://console.cloud.google.com/apis/credentials → OAuth 2.0 Client IDs
# Application type: Web application
# Authorized redirect URI: https://app.api-divonr.xyz/oauth/google/callback
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# ── Optional: Server tuning ───────────────────────────────────────────────────

# Port override (default: 8091)
# KTOR_PORT=8091

# Data directory override (default: ~/.llm-api-web)
# LLM_WEB_DATA_DIR=/home/divonr/.llm-api-web

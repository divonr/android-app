# LLM API Web Server — Environment Variables
# Copy this file to llm-web.env and fill in real values.
# The real llm-web.env is gitignored.

# ── Required ──────────────────────────────────────────────────────────────────

# Secret used to sign session cookies (any long random string, e.g. openssl rand -hex 32)
WEB_UI_SESSION_SECRET=change-me-before-deploying

# Path to the built React app (web/dist)
WEB_STATIC_DIR=/home/divonr/ApI/android-app/web/dist

# Public URL (used to build OAuth redirect URIs)
PUBLIC_BASE_URL=https://app.api-divonr.xyz

# ── Google Sign-In (login) ────────────────────────────────────────────────────
# Required for users to log in.  Create a Web application OAuth 2.0 client at:
#   https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://app.api-divonr.xyz/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret

# Optional: comma-separated list of Google accounts allowed to log in.
# Leave unset (or empty) to allow any Google account.
# ALLOWED_GOOGLE_EMAILS=alice@example.com,bob@example.com

# ── Optional: GitHub OAuth App credentials ────────────────────────────────────
# Needed only for GitHub Workspace integration (connecting GitHub to a chat).
# Create at: https://github.com/settings/developers → OAuth Apps
# Callback URL: https://app.api-divonr.xyz/oauth/github/callback
# (Leave unset to use the built-in desktop app fallback)
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=

# ── Optional: Google Workspace OAuth credentials ──────────────────────────────
# Needed only for Google Workspace integration (Drive/Docs/etc. in chat).
# Authorized redirect URI: https://app.api-divonr.xyz/oauth/google/callback
# (Uses the same Google OAuth client as Sign-In above if left unset)
# GOOGLE_WORKSPACE_OAUTH_CLIENT_ID=
# GOOGLE_WORKSPACE_OAUTH_CLIENT_SECRET=

# ── Remote sync (per-user, seeded at login) ───────────────────────────────────
# The sync server URL is used by the server to mint per-user tokens at login
# (via POST /auth/google on the sync server) and for background pulls.
# Defaults to http://localhost:8090.
# SYNC_SERVER_URL=http://localhost:8090

# How often to pull from the sync server in the background (default 20 s).
# SYNC_PULL_INTERVAL_SECONDS=20

# ── Optional: Server tuning ───────────────────────────────────────────────────

# Port override (default: 8091)
# KTOR_PORT=8091

# Data directory override (default: ~/.llm-api-web)
# LLM_WEB_DATA_DIR=/home/divonr/.llm-api-web
